extends layouts/main

block contenido
  .formulario-contenedor
    .formulario-tarjeta
      h2 🔁 Reasignar Turno Ausente
      p.subtitulo Se genera un nuevo turno para el mismo socio, disciplina y sala. Si la sala está completa en el horario elegido y admite sobreturnos, el turno se genera como sobreturno con el motivo indicado.

      ul
        li
          strong Turno original:
          span= `#${turno.id} - ${new Date(turno.fechaHora).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires' })}`
        li
          strong Socio:
          span= cliente ? `${cliente.apellido}, ${cliente.nombre} (DNI ${cliente.dni})` : `Socio #${turno.clienteId}`
        li
          strong Disciplina:
          span= servicio ? servicio.nombre : `Servicio #${turno.servicioId}`
        li
          strong Sala:
          span= sala ? `${sala.nombre} (capacidad: ${sala.capacidadNormal}; sobreturnos permitidos: ${sala.calcularSobreturnosPermitidos()})` : `Sala #${turno.salaId}`

      if errorReasignacion
        .alerta.alerta-error
          strong ⚠️ No se pudo reasignar:
          span= errorReasignacion

      form(action=`/vista/turnos/reasignar/${turno.id}`, method="POST", class="form-estilizado", data-confirm="¿Confirmar la reasignación de este turno?")
        .grupo-campo
          label(for="instructorId") Docente:
          select#instructorId(name="instructorId", required)
            each i in instructores
              option(value=i.id, selected=(Number(i.id) === Number(turno.instructorId)))= `${i.apellido}, ${i.nombre} (Esp: ${i.especialidad})`
        .fila-campos
          .grupo-campo
            label(for="fecha") Nueva fecha:
            input#fecha(type="date", name="fecha", required)
          .grupo-campo
            label(for="hora") Horario de inicio (Grilla Oficial):
            select#hora(name="hora", required)
              option(value="") -- Seleccionar franja --
              each f in franjasHorarias
                option(value=f)= `${f} hs (Bloque de 60 min)`
        .grupo-campo
          label(for="motivo") Motivo de sobreturno (solo si la sala está completa; mínimo 5 caracteres):
          input#motivo(type="text", name="motivo", placeholder="Ej: Reasignación por inasistencia justificada")
        button.btn-primario(type="submit") Confirmar Reasignación
      .enlace-secundario
        a.btn-volver(href="/vista/turnos") &larr; Volver a la Grilla de Turnos
