extends layouts/main

block contenido
  .encabezado-seccion
    .titulo-con-accion
      div
        h2 Mis Clases y Turnos Reservados
        p Hola #{usuario.nombre} #{usuario.apellido} (DNI #{usuario.dni}). Acá podés consultar el estado de tus reservas y agendar nuevas actividades.
      div
        a.btn-primario(href="/reservar") ➕ Reservar Nueva Clase
  if mensajeExito
    .alerta.alerta-exito
      strong ✅ ¡Operación exitosa! 
      span= mensajeExito
  if mensajeError
    .alerta.alerta-error
      strong ⚠️ Atención: 
      span= mensajeError
  table.tabla-turnos
    thead
      tr
        th ID
        th Actividad / Disciplina
        th Instructor/a
        th Sala
        th Fecha y Hora
        th Estado
        th Modalidad
        th Acciones
    tbody
      if turnos.length
        each t in turnos
          tr(class=t.esSobreturno ? 'fila-sobreturno' : '')
            td
              code= t.id
            td
              strong= t.servicioNombre
            td= t.instructorNombre
            td= t.salaNombre
            td= `${t.fechaFormateada} - ${t.horaFormateada} hs`
            td
              if t.estado === 'reservado'
                span.badge.badge-reservado Reservado
              else if t.estado === 'atendido'
                span.badge.badge-atendido Presente / Atendido
              else
                span.badge.badge-cancelado Cancelado
            td= t.esSobreturno ? 'SOBRETURNO' : 'REGULAR'
            td
              if t.estado === 'reservado'
                if t.permiteCancelar
                  form(action=`/mis-turnos/cancelar/${t.id}`, method="POST", data-confirm="¿Seguro que deseas cancelar esta reserva?")
                    button.btn-peligro-chico(type="submit") Cancelar
                else
                  span.texto-apagado(title="Cancelación solo con 4 hs de anticipación") Bloqueado (< 4 hs)
              else
                span.texto-apagado -
      else
        tr
          td(colspan="8")
            p Todavía no tenés ningún turno reservado.
            a.btn-primario(href="/reservar") Reservá tu primera clase ahora &rarr;