extends layouts/main

block contenido
  .encabezado-seccion
    .titulo-con-accion
      div
        h2 Grilla Operativa de Turnos (Recepción y Asistencia)
        p Control de acceso de socios al establecimiento, acreditación en mostrador (Check-in RF-02) y gestión de sobrecupos autorizados.
      div
        button#btn-toggle-sobreturno.btn-secundario(type="button") ⚡ Autorizar Sobreturno

  #modal-sobreturno.caja-desplegable(class=(errorSobreturno ? 'activo' : ''))
    .formulario-tarjeta
      h3 ⚡ Autorización de Sobreturno de Recepción (Regla del 15%)
      p.subtitulo Los sobreturnos exigen justificativo explícito (mínimo 5 caracteres) y respetan el aforo máximo del 15% por sala.
      
      if errorSobreturno
        .alerta.alerta-error
          strong Error: 
          span= errorSobreturno

      form(action="/vista/turnos/sobreturno", method="POST", class="form-estilizado")
        .fila-campos
          .grupo-campo
            label(for="clienteId") Socio / Paciente:
            select#clienteId(name="clienteId", required)
              option(value="") -- Seleccionar socio --
              each c in socios
                option(value=c.id)= `${c.apellido}, ${c.nombre} - DNI ${c.dni}${c.aptoMedicoVigente ? '' : ' (apto vencido)'}`
          .grupo-campo
            label(for="servicioId") Actividad / Disciplina:
            select#servicioId(name="servicioId", required)
              option(value="") -- Seleccionar actividad --
              each s in servicios
                option(value=s.id)= `${s.nombre} (${s.modalidad}) - Duración: ${s.duracionMinutos} min`
        .fila-campos
          .grupo-campo
            label(for="instructorId") Instructor / Docente:
            select#instructorId(name="instructorId", required)
              option(value="") -- Seleccionar docente --
              each i in instructores
                option(value=i.id)= `${i.apellido}, ${i.nombre} - Especialidad: ${i.especialidad}`
          .grupo-campo
            label(for="salaId") Sala / Espacio Físico:
            select#salaId(name="salaId", required)
              option(value="") -- Seleccionar sala --
              each sala in salas
                option(value=sala.id)= `${sala.nombre} (Capacidad estándar: ${sala.capacidadNormal} personas)`
        .fila-campos
          .grupo-campo
            label(for="fechaHora") Fecha y Hora:
            input#fechaHora(type="datetime-local", name="fechaHora", required)
          .grupo-campo
            label(for="motivo") Motivo Justificado (Mín. 5 caracteres):
            input#motivo(type="text", name="motivo", placeholder="Ej: Urgencia médica / derivación", required)
        button.btn-primario(type="submit") Registrar y Autorizar Sobreturno

  table.tabla-turnos
    thead
      tr
        th ID Turno
        th Socio / Cliente
        th Apto Físico / Alerta Postural
        th Disciplina
        th Docente
        th Sala
        th Fecha y Hora
        th Estado
        th Modalidad
        th Control de Ingreso (Recepción)
    tbody
      if turnos.length
        each t in turnos
          tr(class=t.esSobreturno ? 'fila-sobreturno' : '')
            td
              code= t.id
            td
              strong= t.clienteDetalle || `Socio #${t.clienteId}`
            td
              if t.aptoMedicoVigente
                span.badge.badge-atendido Apto Vigente
              else
                span.badge.badge-cancelado Vencido
              if t.patologiasActivas
                span.badge.badge-sobreturno ⚠️ #{t.patologiasActivas}
            td= t.servicioDetalle
            td= t.instructorDetalle
            td= t.salaDetalle || `Sala #${t.salaId}`
            td= new Date(t.fechaHora).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires' })
            td
              if t.estado === 'reservado'
                span.badge.badge-reservado Reservado
              else if t.estado === 'atendido'
                span.badge.badge-atendido Presente / Atendido
              else
                span.badge.badge-cancelado Cancelado
            td
              if t.esSobreturno
                span.badge.badge-sobreturno SOBRETURNO
              else
                span.badge.badge-regular REGULAR
            td
              if t.estado === 'reservado'
                .acciones-fila
                  form(action=`/vista/turnos/atender/${t.id}`, method="POST")
                    button.btn-exito-chico(type="submit", title="Marcar presente al ingreso del socio") Atender Ingreso
                  form(action=`/vista/turnos/cancelar/${t.id}`, method="POST", data-confirm="¿Cancelar este turno?")
                    button.btn-peligro-chico(type="submit", title="Cancelar turno") ❌ Cancelar
              else if t.estado === 'atendido'
                span.texto-verde-bold ✔ Acreditado
              else
                span.texto-apagado -
      else
        tr
          td(colspan="10") No se registran turnos en la base de datos de MongoDB.