extends layouts/main

block contenido
  .encabezado-seccion
    .titulo-con-accion
      div
        h2 Padrón General de Socios y Colaboradores
        p Gestión de estados históricos, apto médico preventivo y administración de credenciales.
      div
        span.etiqueta-info Mostrador Espacio Sideral S.A.S.
  if mensajeExito
    .alerta.alerta-exito
      strong ✅ Operación Exitosa: 
      span= mensajeExito
  if mensajeError
    .alerta.alerta-error
      strong ⚠️ Atención: 
      span= mensajeError
  table.tabla-turnos
    thead
      tr
        th ID
        th Apellido y Nombre
        th DNI
        th Correo Electrónico
        th Rol
        th Estado
        th Apto Físico
        th Acciones de Mostrador
    tbody
      if clientes.length
        each c in clientes
          tr
            td
              code= c.id
            td
              strong= `${c.apellido}, ${c.nombre}`
            td= c.dni
            td= c.email
            td
              if c.rol === 'empleado'
                span.badge.badge-empleado Recepción: Personal
              else
                span.badge.badge-regular Socio
            td
              if c.estado === 'activo'
                span.badge.badge-atendido Activo
              else if c.estado === 'licencia'
                span.badge.badge-reservado Licencia
              else
                span.badge.badge-cancelado Inactivo
            td
              if c.aptoMedicoVigente
                span.texto-verde-bold Vigente (OK)
              else
                span.badge.badge-cancelado Vencido
            td
              .acciones-fila
                form(action=`/clientes/vista/clientes/cambiar-estado/${c.id}`, method="POST")
                  select(name="nuevoEstado", onchange="this.form.submit()")
                    option(value="activo", selected=c.estado === 'activo') Activo
                    option(value="inactivo", selected=c.estado === 'inactivo') Inactivo
                    option(value="licencia", selected=c.estado === 'licencia') Licencia
                form(action=`/clientes/vista/clientes/resetear-password/${c.id}`, method="POST", data-confirm=`¿Confirma el blanqueo de contraseña para ${c.nombre} ${c.apellido}? Se restablecerá a '123456' y se levantará cualquier bloqueo por intentos fallidos.`)
                  button.btn-reset-chico(type="submit", title="Restablecer contraseña a 123456") 🔑 Blanquear Clave
      else
        tr
          td(colspan="8") No hay usuarios registrados en el padrón.