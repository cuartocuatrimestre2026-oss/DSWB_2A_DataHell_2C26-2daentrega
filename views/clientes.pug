extends layouts/main

block contenido
  .encabezado-seccion
    h2 Padrón General de Socios y Personal
    p Base de usuarios de Espacio Sideral S.A.S. gestionada con persistencia NoSQL en MongoDB.
  table.tabla-turnos
    thead
      tr
        th ID
        th Apellido y Nombre
        th DNI
        th Correo Electrónico
        th Teléfono
        th Perfil / Rol
        th Estado
    tbody
      if clientes.length
        each c in clientes
          tr
            td
              code= c.id
            td
              strong= `${c.apellido}, ${c.nombre}`
            td= c.dni
            td= c.email
            td= c.telefono || 'Sin teléfono'
            td
              if c.rol === 'empleado'
                span.badge.badge-empleado Personal Administrativo
              else
                span.badge.badge-regular Socio / Paciente
            td
              if c.estado === 'activo'
                span.badge.badge-atendido Activo
              else if c.estado === 'licencia'
                span.badge.badge-sobreturno En Licencia
              else
                span.badge.badge-cancelado Inactivo (Histórico)
      else
        tr
          td(colspan="7" style="text-align: center; padding: 25px;") No se registran usuarios en la base de datos.
  .acciones-retorno
    a.btn-volver(href="/") &larr; Volver al Inicio
    a.btn-volver(href="/vista/turnos") Ir a la Grilla de Recepción &rarr;